#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

#define SIZE 1000000

int main() {
    int *data = malloc(SIZE * sizeof(int));

    if (data == NULL) {
        printf("Memory allocation failed\n");
        return 1;
    }

    // Initialize data
    for (int i = 0; i < SIZE; i++)
        data[i] = 10;

    printf("Before fork: data[0] = %d\n", data[0]);

    pid_t pid = fork();

    if (pid < 0) {
        printf("Fork failed\n");
        free(data);
        return 1;
    }

    if (pid == 0) {
        // Child process
        printf("Child before modification: data[0] = %d\n", data[0]);

        // Modify the data
        data[0] = 999;

        printf("Child after modification: data[0] = %d\n", data[0]);

        free(data);
        exit(0);
    }
    else {
        // Parent process
        wait(NULL);

        printf("Parent after child modification: data[0] = %d\n", data[0]);

        free(data);
    }

    return 0;
}
