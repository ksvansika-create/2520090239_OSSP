#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <sys/wait.h>
#include <string.h>

#define FIFO1 "client_to_server"
#define FIFO2 "server_to_client"

int main() {
    char message[100];
    char response[100];

    mkfifo(FIFO1, 0666);
    mkfifo(FIFO2, 0666);

    pid_t pid = fork();

    if (pid == 0) {
        // CLIENT
        printf("Enter message: ");
        fflush(stdout);

        fgets(message, sizeof(message), stdin);
        message[strcspn(message, "\n")] = '\0';

        int fd = open(FIFO1, O_RDWR);
        write(fd, message, strlen(message) + 1);
        close(fd);

        fd = open(FIFO2, O_RDWR);
        read(fd, response, sizeof(response));
        close(fd);

        printf("Server response: %s\n", response);
    }
    else {
        // SERVER
        int fd = open(FIFO1, O_RDWR);
        read(fd, message, sizeof(message));
        close(fd);

        printf("Server received: %s\n", message);

        strcpy(response, "Message processed successfully.");

        fd = open(FIFO2, O_RDWR);
        write(fd, response, strlen(response) + 1);
        close(fd);

        wait(NULL);

        unlink(FIFO1);
        unlink(FIFO2);
    }

    return 0;
}
